{
    # Global options
    frankenphp
    order php_server before file_server
}

:80 {
    # Set the root directory
    root * /var/www/html 

    # Global security mitigation against massive payload attacks (DoS/OOM)
    request_body {
        max_size 2MB
    }

    # Enable compression
    encode zstd gzip 

    # Early Authentication direct in Caddy pentru /log.php
    # Daca header-ul X-API-KEY nu contine valoarea corecta din variabila de mediu, respinge instant cu 401
    @unauthorized {
        path /log.php
        not header X-API-KEY "{$LOG_API_KEY}"
    }
    respond @unauthorized "Unauthorized" 401

    # Protect sensitive files and directories by faking a 404 Not Found
    @forbidden {
        path /bin /bin/*
        path /db /db/*
        path /dist /dist/*
        path /docker /docker/*
		path /lang /lang/*
		path /src /src/*
        path /tests /tests/*
        path /vendor /vendor/*
        path .dockerignore
        path .env*
        path .gitignore
        path /composer.json
        path /composer.lock
        path /phinx.php
        path /phpunit.xml
        path /rector.php
    }
    respond @forbidden "Not Found" 404

    # Execute PHP files
    php_server 
}
