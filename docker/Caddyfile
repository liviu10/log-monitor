{
	# Global options
	frankenphp
	order php_server before file_server
}

:80 {
	# Setare director radacina in container
	root * /var/www/html

	# Activare compresie nativa pentru performanta
	encode zstd gzip

	# Protectie fisiere sensibile la nivel de server web
	@forbidden {
		path .env*
		path /phinx.php
		path /composer.json
		path /composer.lock
		path /docker/*
	}
	respond @forbidden "Access Denied" 403

	# Securitate la nivel de server web (Caddy)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self';"
		-Server
	}

	# Executare PHP si integrare cu runtime-ul PHP
	php_server
}