# MariaDB tuned for a small, single-app workload on a 4-core / NVMe box.
# Buffer pool and max_connections are set from .env via the compose command.
[mysqld]
# --- Footprint ---
performance_schema = OFF
skip-name-resolve
thread_cache_size = 8
# Pool of worker threads instead of one OS thread per connection.
thread_handling = pool-of-threads
table_open_cache = 400
table_definition_cache = 400
open_files_limit = 2048
key_buffer_size = 8M
aria_pagecache_buffer_size = 16M
tmp_table_size = 16M
max_heap_table_size = 16M
join_buffer_size = 256K
sort_buffer_size = 512K
read_buffer_size = 128K
read_rnd_buffer_size = 256K
max_allowed_packet = 16M

# --- InnoDB (NVMe) ---
innodb_log_file_size = 64M
innodb_log_buffer_size = 8M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_io_capacity = 1000
innodb_io_capacity_max = 4000
innodb_file_per_table = ON

# --- Connections ---
max_connect_errors = 1000

# --- Logging (no binlog: single node, no replication) ---
skip-log-bin
slow_query_log = ON
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

# --- Charset / time ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = 'Europe/Bucharest'

[mysql]
default-character-set = utf8mb4
