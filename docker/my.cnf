[mysqld]
# Optimizari specifice si alocare pool de memorie
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# Securizare: Previne citirea/scrierea de fisiere pe container prin SQL Injection
secure_file_priv = NULL

# Conexiuni
max_connections = 100
thread_cache_size = 8

# Optimizari Buffere
join_buffer_size = 4M
sort_buffer_size = 2M
read_rnd_buffer_size = 2M

# Character Set & Timezone standardizat
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = 'Europe/Bucharest'

[mysql]
default-character-set = utf8mb4