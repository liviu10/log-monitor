[mysqld]
# Optimizari specifice si sigure pentru MariaDB 12.3.2
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2

# Managementul conexiunilor pentru API de mare viteza
max_connections = 150
thread_cache_size = 16
thread_handling = one-thread-per-connection

# Buffere interne adaptate pentru interogari text si JSON fulltext
join_buffer_size = 2M
sort_buffer_size = 2M
read_rnd_buffer_size = 1M

# Setari stricte de securitate si standardizare a datelor
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = 'Europe/Bucharest'

[mysql]
default-character-set = utf8mb4
