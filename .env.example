# Application Settings (use "production" or "development")
APP_ENV=development
APP_NAME=LogMonitor
TZ=Europe/Bucharest

# Docker Network & Resources
APP_PORT=8080
APP_CPU_LIMIT=0.5
APP_MEMORY_LIMIT=256M
WORKER_CPU_LIMIT=0.3
WORKER_MEMORY_LIMIT=128M
FRANKENPHP_WORKERS=2

# Database Configuration
DB_BUFFER_POOL_SIZE=64M
DB_MAX_CONNECTIONS=50
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=512M
DB_BIND_IP=127.0.0.1
DB_HOST=db
DB_DATABASE=log_monitor
DB_USERNAME=user
DB_PASSWORD=password
DB_PORT=33061
MYSQL_ROOT_PASSWORD=rootpassword

# SMTP Configuration (Optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=admin@logmonitor.local

# Log Monitor Configuration
LOG_SERVER_URL="http://127.0.0.1/api/log.php"
LOG_API_KEY=""
NIST_API_KEY=""
