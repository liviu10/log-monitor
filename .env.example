# ==============================================================================
# LogMonitor - NON-SECRET settings (copy to .env, chmod 600)
#
# Passwords and keys live in ./secrets/* as Docker secrets, provisioned by:
#   sudo ./ops server-setup <user>
#   app_key, db_password, db_root_password, log_api_key, smtp_password, admin_password
# ==============================================================================

# Application
APP_ENV=production
APP_NAME="LogMonitor"
APP_URL="https://log-monitor.insightdevhub.ro"
TZ=Europe/Bucharest
SESSION_IDLE_TIMEOUT=1800

# Web port published on the host (cloudflared -> http://127.0.0.1:8082)
APP_BIND=127.0.0.1
APP_PORT=8082
FRANKENPHP_WORKERS=4

# Container resource limits
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=512M
WORKER_CPU_LIMIT=0.5
WORKER_MEMORY_LIMIT=256M
LOG_WORKER_CPU_LIMIT=1.0
LOG_WORKER_MEMORY_LIMIT=512M
DB_CPU_LIMIT=2.0
DB_MEMORY_LIMIT=1G

# Database (DB_HOST/DB_PORT are fixed by docker-compose.yml)
DB_BUFFER_POOL_SIZE=512M
DB_MAX_CONNECTIONS=100
DB_DATABASE=log_monitor
DB_USERNAME=log_monitor_user

# SMTP (password: secrets/smtp_password)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_FROM="noreply@log-monitor.insightdevhub.ro"
PROXY_HOST=""
PROXY_PORT=""
SMTP_PROXY_INSECURE=""

# Centralized Self-Telemetry (HTTPS through Cloudflare; http:// is rejected in production)
LOG_SERVER_URL="https://log-monitor.insightdevhub.ro/api/log.php"

# Database bootstrap on every app container start (docker/docker-entrypoint.sh)
AUTO_MIGRATE=true
AUTO_SEED=true

# First production administrator — used ONLY while no ADMIN user exists.
# Password: secrets/admin_password (>= 14 chars); clear it after the first deploy.
ADMIN_EMAIL=""

# Backups (./ops backup, daily at 02:30 + before every deploy)
BACKUP_DIR=""
BACKUP_KEEP_DAYS=14
BACKUP_AGE_RECIPIENT=""
BACKUP_RCLONE_REMOTE=""
