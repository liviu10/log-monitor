# Application Settings (use "production" or "development")
APP_ENV=production
APP_NAME=LogMonitor
APP_URL=https://log-monitor.insightdevhub.ro
TZ=Europe/Bucharest
SESSION_IDLE_TIMEOUT=1800

# Docker Network & Resources
APP_BIND_IP=127.0.0.1
APP_PORT=8082
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=512M
FRANKENPHP_WORKERS=4

# Database Configuration (Optimized for 16GB RAM)
DB_BUFFER_POOL_SIZE=2G
DB_MAX_CONNECTIONS=100
DB_CPU_LIMIT=2.0
DB_MEMORY_LIMIT=3G
DB_BIND_IP=127.0.0.1
DB_HOST=db
DB_DATABASE=log_monitor
DB_USERNAME=user
DB_PASSWORD=password
DB_PORT=33061
MYSQL_ROOT_PASSWORD=rootpassword

# SMTP Configuration (Optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=admin@logmonitor.local

# Log Monitor Configuration
LOG_SERVER_URL="http://127.0.0.1:8082/api/log.php"
LOG_API_KEY=""
NIST_API_KEY=""
