{
    "name": "liviu/log-monitor",
    "description": "Centralized logging system for PHP applications",
    "type": "project",
    "require": {
        "php": "^8.4",
        "phpmailer/phpmailer": "^6.9",
        "robmorgan/phinx": "^0.16.0",
        "symfony/var-dumper": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.16",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.1",
        "rector/rector": "^2.4"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "stan": "php -d memory_limit=2G vendor/bin/phpstan analyse -c phpstan.neon -l 10",
        "security:deps": "composer audit --locked --ignore-unreachable",
        "trivy": "trivy fs --severity HIGH,CRITICAL .",
        "check": [
            "@lint",
            "@stan",
            "@security:deps",
            "@test",
            "@trivy"
        ],
        "qa": "./scripts/qa.sh"
    }
}
